
# SmartHome backend secret environment file example.

# Copy this file to a server-local path such as /etc/smarthome/smarthome-backend.secrets.env.

# Do not commit the copied file because it contains production secrets.

# PostgreSQL password used by the application datasource.
DB_PASSWORD=change-me

# Initial administrator password used by the application.
ADMIN_PASSWORD=change-me

# JWT signing secret. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Separate 32-byte random AES key, encoded as standard Base64, for Agent recovery responses.
# Agent APIs never authenticate using GATEWAY_AGENT_API_KEYS.
AGENT_RESPONSE_ENCRYPTION_KEY=

# Mosquitto Dynamic Security control account (separate from MQTT publisher and agents).
AGENT_MQTT_CONTROL_USERNAME=
AGENT_MQTT_CONTROL_PASSWORD=

# Comma-separated API keys for IoT devices.
GATEWAY_IOT_API_KEYS=

# MQTT username when the broker requires authentication.
MQTT_USERNAME=

# MQTT password when the broker requires authentication.
MQTT_PASSWORD=

# Discord webhook URL used for warning and critical notifications.
DISCORD_WEBHOOK_URL=
